{
  "name": "impoc-backend",
  "version": "1.0.0",
  "description": "Backend API for IMPOC Shop Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all",
    "db:reset": "bash scripts/db-reset.sh",
    "db:refresh": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:auth": "NODE_OPTIONS=--experimental-vm-modules jest tests/auth --forceExit",
    "test:users": "NODE_OPTIONS=--experimental-vm-modules jest tests/users --forceExit",
    "test:roles": "NODE_OPTIONS=--experimental-vm-modules jest tests/roles --forceExit",
    "test:permissions": "NODE_OPTIONS=--experimental-vm-modules jest tests/permissions --forceExit"
  },
  "keywords": [
    "node",
    "express",
    "postgresql",
    "sequelize",
    "shop-management",
    "pos",
    "inventory"
  ],
  "author": "Raviraj",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "bwip-js": "^4.11.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
