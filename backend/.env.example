DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB_name
# Separate database used by `npm test`. The suite runs sync({ force: true }),
# which DROPS every table, so this must never point at your dev database.
DB_NAME_TEST=DB_name_test
DB_USER=postgres
DB_PASSWORD=your_password

PORT=3000

FRONTEND_ORIGIN=http://localhost:3000

# REQUIRED: the server refuses to boot unless this is a random string of at
# least 32 characters (and not a placeholder). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The old placeholder 'your-long-random-access-secret' is actively rejected.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Unused by the current code (refresh tokens are opaque random strings); it is
# kept for future symmetric refresh JWTs and must satisfy the same strength bar.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

JWT_ISSUER=shree-fashion-api
JWT_AUDIENCE=shree-fashion-client

SEED_ADMIN_PASSWORD=Admin@12345