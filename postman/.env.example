# ============================================
# Postman Collection Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# Then import into Postman

# ============================================
# API Configuration
# ============================================
baseUrl=http://localhost:5000

# ============================================
# Authentication Tokens
# ============================================
# These are auto-populated after login
# Leave empty initially, they'll be filled by the login endpoint
accessToken=
refreshToken=

# ============================================
# Test User Credentials
# ============================================
# Use these to test login endpoint
# DEV-ONLY seed credentials, rotated 2026-09 (SEC-L-4). The password must equal
# the SEED_ADMIN_PASSWORD used when seeding the backend. NEVER reuse in prod.
testUsername=admin
testPassword=Impoc-Devseed-2026!

# ============================================
# Role UUIDs
# ============================================
# Get these from GET /api/roles after login
# ADMIN role UUID
adminRoleUuid=

# MANAGER role UUID
managerRoleUuid=

# INVENTORY_MANAGER role UUID
inventoryManagerRoleUuid=

# CASHIER role UUID
cashierRoleUuid=

# ACCOUNTANT role UUID
accountantRoleUuid=

# Generic role UUID (for creating/updating tests)
roleUuid=

# ============================================
# Permission UUIDs
# ============================================
# Get these from GET /api/permissions after login
permissionUuid=

# ============================================
# Test Entity UUIDs
# ============================================
# Update these with actual UUIDs from your API

# Test user UUID (for get/update/delete tests)
userUuid=

# Test role UUID (for role operations)
testRoleUuid=

# Test permission UUID (for permission operations)
testPermissionUuid=

# Test session UUID (for session operations)
sessionUuid=

# ============================================
# Test Data for Creating Entities
# ============================================
# New user credentials for testing user creation
newUsername=testuser
newEmail=testuser@example.com
newPassword=TestPassword123
newFirstName=Test
newLastName=User
newPhone=9999999999

# New role data
newRoleName=TEST_ROLE
newRoleDescription=Test role for API testing

# New permission data
newPermissionName=test.permission
newPermissionDescription=Test permission for API testing

# ============================================
# Pagination & Filtering (Optional)
# ============================================
pageNumber=1
pageSize=10
sortBy=createdAt
sortOrder=DESC
