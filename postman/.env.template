# POSTMAN ENVIRONMENT VARIABLES - Template with Default Values
# Copy these values and paste into Postman environment

# Basic Setup (Required)
baseUrl=http://localhost:5000
testUsername=admin
# DEV-ONLY seed password, rotated 2026-09 (SEC-L-4). Must equal the
# SEED_ADMIN_PASSWORD used when seeding the backend. NEVER reuse in production.
testPassword=Impoc-Devseed-2026!

# Auto-populated after login (leave empty initially)
