DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB_name
# Separate database used by `npm test`. The suite runs sync({ force: true }),
# which DROPS every table, so this must never point at your dev database.
DB_NAME_TEST=DB_name_test
DB_USER=postgres
DB_PASSWORD=your_password

PORT=3000

FRONTEND_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=your-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

JWT_ISSUER=shree-fashion-api
JWT_AUDIENCE=shree-fashion-client

SEED_ADMIN_PASSWORD=Admin@12345